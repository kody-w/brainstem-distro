{
  "id": "my-distro",
  "display_name": "My Brainstem",
  "version": "0.1.0",
  "engine": {
    "url": "http://127.0.0.1:7071",
    "install_hint": "Install the Brainstem first: curl -fsSL https://kody-w.github.io/rapp-installer/install.sh | bash"
  },
  "agents_dir": null,
  "connect_domains": [
    "https://raw.githubusercontent.com"
  ],
  "labels": [],
  "voices": {
    "Claude": {
      "command": [
        "claude",
        "-p",
        "--tools",
        "",
        "--strict-mcp-config",
        "--no-session-persistence",
        "--output-format",
        "text"
      ],
      "stdin": true,
      "cost": "subscription"
    },
    "Codex": {
      "command": [
        "codex",
        "exec",
        "--sandbox",
        "read-only",
        "--skip-git-repo-check",
        "--ephemeral",
        "-o",
        "{out}",
        "-"
      ],
      "stdin": true,
      "cost": "subscription"
    },
    "Copilot": {
      "command": [
        "copilot",
        "-p",
        "{prompt}",
        "-s",
        "--available-tools",
        ""
      ],
      "cost": "subscription"
    }
  },
  "max_rounds": 6
}
